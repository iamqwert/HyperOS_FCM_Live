<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Update check via GitHub Releases. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The app list is built without any permission. On Android 11+ package
         visibility is granted per matching intent filter, so declaring the
         push actions below makes exactly the push-capable apps visible — the
         only apps the allowlist can mean anything for — and nothing else.
         GMS is listed by name because it is the one package the module
         exists for and must never be lost to a query quirk (see the scan
         comment in MainActivity). The MiPush check is a direct component
         lookup, which works on any already-visible package, so it needs no
         declaration of its own. -->
    <queries>
        <intent>
            <action android:name="com.google.firebase.MESSAGING_EVENT" />
        </intent>
        <intent>
            <action android:name="com.google.firebase.INSTANCE_ID_EVENT" />
        </intent>
        <intent>
            <action android:name="com.google.android.c2dm.intent.RECEIVE" />
        </intent>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/xposed_description"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperFCMLive">

        <!-- Settings UI. No LAUNCHER category here: the desktop icon is the
             alias below, so we can hide the icon without disabling this activity
             (LSPosed can still open the module via MODULE_SETTINGS /
             LAUNCH_MODULE when the alias is disabled).

             locale|layoutDirection: a language pick applies in place
             (onConfigurationChanged, no destroy-recreate). The recreate was the
             black flash — the old window came down before the new one had drawn,
             and the task void showed for a frame. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- LSPosed / Xposed module "Launch" from the module manager UI. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="org.lsposed.manager.LAUNCH_MODULE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
            <!-- Explicit entry for LSPosed / adb / shortcuts when the icon is hidden. -->
            <intent-filter>
                <action android:name="io.github.howard20181.hyperos.fcmlive.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- `.MainActivity` is the whole app now: every page — the three home
             tabs and what they open (about, licences, experiment) — is an entry
             in its one NavDisplay back stack. The sub-pages used to be
             Activities of their own, and a covered Activity is stopped, so the
             page underneath had to be rebuilt from nothing when the user came
             back to it. Rebuilt is also what it *looked* like: that cost is
             where the jank after a back gesture's release came from. -->

        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/launcher_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
    </application>
</manifest>

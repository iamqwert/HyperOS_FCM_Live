<?xml version="1.0" encoding="utf-8"?>
<!-- First row of a stacked card group: full radius on top, minimal radius where it
     meets the next card, so adjacent corners read as one continuous block. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_popup_item_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_card" />
            <corners
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp"
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp"
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
        </shape>
    </item>
</ripple>

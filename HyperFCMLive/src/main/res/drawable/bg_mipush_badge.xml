<?xml version="1.0" encoding="utf-8"?>
<!-- "MiPush" tag on an app row. Primary-container fill: it has to read as a
     label next to the app name, not as a second switch competing with the
     on/off icon on the right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/md_primary_container" />
    <corners android:radius="6dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Material Symbols "close" (fill1, outlined family). Path data verbatim
     from fonts.gstatic.com (Apache-2.0); the source canvas is 960x960 with a
     -960 y origin, shifted down via the group.
     Same family and weight as ic_check: the two are the switch thumb's on and
     off marks and are never seen apart, so they must not disagree.
     -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <group android:translateY="960">
        <path
            android:fillColor="@android:color/white"
            android:pathData="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
    </group>
</vector>

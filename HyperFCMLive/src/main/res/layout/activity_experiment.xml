<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_page_bg"
        android:gravity="center_vertical"
        android:minHeight="100dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_ripple"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/md_icon_tint" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/experiment"
                android:textColor="@color/md_on_surface"
                style="@style/TextAppearance.HyperFCMLive.TitleLarge" />
        </FrameLayout>
    </LinearLayout>

    <!-- Same safe-area arrangement as the About screen: insets land on the
         scrollable content so the last card rests above the gesture area. -->
    <ScrollView
        android:id="@+id/experiment_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/md_page_bg"
        android:clipToPadding="false"
        android:overScrollMode="always">

        <LinearLayout
            android:id="@+id/experiment_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-medium"
                android:paddingStart="8dp"
                android:paddingTop="28dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp"
                android:text="@string/experiment_section_battery"
                android:textColor="@color/md_primary"
                style="@style/TextAppearance.HyperFCMLive.BodyMedium" />

            <LinearLayout
                android:id="@+id/row_wechat_shield"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_single_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/md_icon_tint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:text="@string/experiment_wechat_shield"
                        android:textColor="@color/md_on_surface"
                        style="@style/TextAppearance.HyperFCMLive.BodyLarge" />

                    <TextView
                        android:id="@+id/wechat_shield_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:textColor="@color/md_on_surface_variant"
                        style="@style/TextAppearance.HyperFCMLive.BodySmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:paddingTop="4dp"
                        android:text="@string/experiment_wechat_shield_desc"
                        android:textColor="@color/md_on_surface_variant"
                        style="@style/TextAppearance.HyperFCMLive.BodySmall" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/wechat_shield_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/experiment_wechat_shield"
                    app:thumbIcon="@drawable/switch_thumb_icon" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

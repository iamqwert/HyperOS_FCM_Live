<?xml version="1.0" encoding="utf-8"?>
<!-- wrap_content card: hugs text+check so checkbox stays ~12dp from label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_menu"
    android:elevation="6dp"
    android:minWidth="180dp"
    android:orientation="vertical"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/menu_show_system"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:background="@drawable/bg_popup_item_bg"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="@drawable/bg_popup_item_ripple"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/menu_show_system_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_system_apps"
            android:textColor="@color/md_on_surface"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/menu_show_system_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/md3_check_off" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_show_fcm"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:background="@drawable/bg_popup_item_bg"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="@drawable/bg_popup_item_ripple"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/menu_show_fcm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_fcm_supported_apps"
            android:textColor="@color/md_on_surface"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/menu_show_fcm_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/md3_check_off" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_hide_icon"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:background="@drawable/bg_popup_item_bg"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="@drawable/bg_popup_item_ripple"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/menu_hide_icon_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hide_launcher_icon"
            android:textColor="@color/md_on_surface"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/menu_hide_icon_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/md3_check_off" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_about"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_popup_item_bg"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="@drawable/bg_popup_item_ripple"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/menu_about_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about"
            android:textColor="@color/md_on_surface"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>

    <!-- 实验功能页：危险开关集中在此，主界面只留入口 -->
    <string name="experiment">实验功能</string>
    <string name="experiment_section_battery">电池</string>
    <string name="experiment_wechat_shield">禁止系统恢复微信省电策略</string>
    <string name="experiment_wechat_shield_desc">仅在上一项开启时生效；阻止手机管家改写微信的省电策略为「无限制」，需自行前往手机管家调整相关选项</string>
    <string name="experiment_wechat_doze_keepout">禁止系统将微信写回电池未优化名单</string>
    <string name="experiment_wechat_doze_keepout_desc">启用后，将阻止微信进入 AOSP 电池优化中的「未优化」名单，需自行调整为优化</string>

    <string name="experiment_section_sleep">睡眠模式</string>
    <string name="experiment_sleep_keepalive">保护 WiFi 不断网</string>
    <string name="experiment_sleep_keepalive_desc">启用后，进入睡眠模式时 WiFi 保持开启，FCM 通道不会整夜中断；夜间耗电增加</string>
    <string name="experiment_sleep_keepalive_data">保护移动数据不断网</string>
    <string name="experiment_sleep_keepalive_data_desc">启用后，移动数据与 WiFi 均保持整夜不断网；夜间耗电更多</string>
    <string name="experiment_sleep_keepalive_charging">仅在充电时不断网</string>
    <string name="experiment_sleep_keepalive_charging_desc">启用后，夜间未充电时将保持系统原有的睡眠断网策略以省电</string>


<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material 3 baseline theme.

      minSdk is 35, so the window is ALWAYS edge-to-edge: Android 15 ignores
      windowStatusBarColor / windowNavigationBarColor /
      windowDrawsSystemBarBackgrounds and draws both bars transparent. The page
      colour comes from windowBackground plus the per-screen inset handling
      (ThemeSupport.applyWindow, UiUtils.topInset / bottomInset).

      Color roles map 1:1 onto the runtime AppPalette (ThemeEngine / mcu), so the
      framework's own widgets — the system file picker's chrome, a dialog the
      platform raises — land on the same palette the Compose tree is drawn with.
      The five screens themselves read no `@color/`: they are painted from
      `MaterialTheme.colorScheme`, which ComposeTheme maps from AppPalette.
    -->
    <style name="Theme.HyperFCMLive" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/md_page_bg</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- M3 color roles (light fallback; runtime AppPalette repaints these). -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/md_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/md_on_surface_inverse</item>

        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceBright">@color/md_surface_bright</item>
        <item name="colorSurfaceDim">@color/md_surface_dim</item>

        <!-- Legacy android: attrs kept for platform widgets. -->
        <item name="android:colorPrimary">@color/md_primary</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
    </style>

    <!--
      Worn by the three sub-page windows (About, Experiment, Licenses) ON TOP of
      the theme above — its parent resolves to the night bag when the app is
      dark, so one definition covers both modes.

      An OPAQUE window stops every window under it: `onStop`, and with it the
      window's surface, its recorded display list and the Compose frame clock.
      That is exactly what a committed predictive back then had to pay for —
      the page being returned to had to be created, laid out and drawn from
      nothing, on the same frames the hand-drawn slide lands on, which is the
      stutter felt at the release of the gesture. A TRANSLUCENT window never
      occludes, so the page below is only paused: still composed, still
      recorded, its buffer still held by the compositor, and the reveal has
      nothing to rebuild.

      Nothing visible moves with it: the window background is still the page
      colour (ThemeSupport.applyWindow paints it at runtime), the page content
      still covers the window, and the platform's own enter animation is left
      alone. `backgroundDimEnabled` is nailed shut because Material's themes
      carry a dim amount for dialogs, and a ROM that inserts that scrim behind a
      translucent window would darken the very page being revealed.
    -->
    <style name="Theme.HyperFCMLive.Translucent" parent="Theme.HyperFCMLive">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>

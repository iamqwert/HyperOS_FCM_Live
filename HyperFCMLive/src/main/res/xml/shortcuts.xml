<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher long-press shortcuts. Each android:icon is an Adaptive Icon
     (drawable/ic_shortcut_*.xml) whose foreground carries the Material Symbols
     glyph: the launcher's own mask draws the silhouette, so nothing is baked
     into the artwork. Per the App Shortcuts Icon Design Guidelines the glyph
     is a 24dp system icon centred in the 48dp shortcut. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutShortLabel="@string/shortcut_settings"
        android:shortcutLongLabel="@string/shortcut_settings_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.howard20181.hyperos.fcmlive"
            android:targetClass="io.github.howard20181.hyperos.fcmlive.AboutActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="help"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_help"
        android:shortcutShortLabel="@string/help"
        android:shortcutLongLabel="@string/shortcut_help_long">
        <!-- Online help: opened in the browser. No targetPackage so the
             launcher resolves ACTION_VIEW to a browser. -->
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/iamqwert/HyperOS_FCM_Live/blob/main/HELP.md" />
    </shortcut>

    <shortcut
        android:shortcutId="fcm_diagnostics"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_fcm"
        android:shortcutShortLabel="@string/fcm_diagnostics"
        android:shortcutLongLabel="@string/shortcut_fcm_diagnostics_long">
        <intent
            android:action="io.github.howard20181.hyperos.fcmlive.FCM_DIAGNOSTICS"
            android:targetPackage="io.github.howard20181.hyperos.fcmlive"
            android:targetClass="io.github.howard20181.hyperos.fcmlive.MainActivity" />
    </shortcut>
</shortcuts>
